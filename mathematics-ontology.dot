digraph Math {
  graph [rankdir=TB bgcolor="transparent" pad="0.25" nodesep="0.30" ranksep="0.42" splines=spline outputorder=edgesfirst];
  node [shape=box style="rounded,filled" fontname="Arial" fontsize=12 fontcolor="#253b36" penwidth=1.2 margin="0.10,0.05"];
  edge [color="#b2bfbb" penwidth=1.1 arrowsize=0.65];
  MATH_001 [id="MATH_001" color="#43605b" fillcolor="#eff4f1" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#43605b">MATH_001</FONT></TD></TR><TR><TD><B>Whole-number place value and<BR/>magnitude</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades ≤5</FONT></TD></TR></TABLE>> tooltip="Interpret whole numbers using base-ten units, relative size, and positions on a number line."];
MATH_002 [id="MATH_002" color="#43605b" fillcolor="#eff4f1" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#43605b">MATH_002</FONT></TD></TR><TR><TD><B>Whole-number addition and<BR/>subtraction</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades ≤5</FONT></TD></TR></TABLE>> tooltip="Combine, separate, and compare whole-number quantities, including regrouping across place values."];
MATH_003 [id="MATH_003" color="#43605b" fillcolor="#eff4f1" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#43605b">MATH_003</FONT></TD></TR><TR><TD><B>Whole-number multiplication<BR/>and division</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades ≤5–6</FONT></TD></TR></TABLE>> tooltip="Reason about equal groups, multiplicative comparisons, products, and quotients."];
MATH_004 [id="MATH_004" color="#866753" fillcolor="#f8f1ec" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#866753">MATH_004</FONT></TD></TR><TR><TD><B>Factors and multiples</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 5–6</FONT></TD></TR></TABLE>> tooltip="Identify divisibility relationships, including common factors and common multiples."];
MATH_005 [id="MATH_005" color="#257a8a" fillcolor="#edf8fa" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#257a8a">MATH_005</FONT></TD></TR><TR><TD><B>Fraction meaning</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades ≤5</FONT></TD></TR></TABLE>> tooltip="Interpret a fraction as a number, a quantity of equal-sized parts, and a quotient."];
MATH_006 [id="MATH_006" color="#257a8a" fillcolor="#edf8fa" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#257a8a">MATH_006</FONT></TD></TR><TR><TD><B>Equivalent fractions</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades ≤5–6</FONT></TD></TR></TABLE>> tooltip="Generate, recognize, and simplify fractions that represent the same number."];
MATH_007 [id="MATH_007" color="#257a8a" fillcolor="#edf8fa" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#257a8a">MATH_007</FONT></TD></TR><TR><TD><B>Fraction addition and<BR/>subtraction</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 5–6</FONT></TD></TR></TABLE>> tooltip="Add and subtract nonnegative fractions by expressing quantities in common fractional units."];
MATH_008 [id="MATH_008" color="#257a8a" fillcolor="#edf8fa" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#257a8a">MATH_008</FONT></TD></TR><TR><TD><B>Fraction multiplication and<BR/>division</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 5–6</FONT></TD></TR></TABLE>> tooltip="Multiply and divide nonnegative fractions using scaling, grouping, and reciprocal relationships."];
MATH_009 [id="MATH_009" color="#257a8a" fillcolor="#edf8fa" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#257a8a">MATH_009</FONT></TD></TR><TR><TD><B>Decimal place value</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades ≤5–6</FONT></TD></TR></TABLE>> tooltip="Interpret decimal digits as tenths, hundredths, and successive powers-of-ten fractional units."];
MATH_010 [id="MATH_010" color="#257a8a" fillcolor="#edf8fa" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#257a8a">MATH_010</FONT></TD></TR><TR><TD><B>Decimal operations</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 5–6</FONT></TD></TR></TABLE>> tooltip="Add, subtract, multiply, and divide nonnegative decimals while accounting for place value."];
MATH_011 [id="MATH_011" color="#257a8a" fillcolor="#edf8fa" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#257a8a">MATH_011</FONT></TD></TR><TR><TD><B>Fraction–decimal conversion</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 5–7</FONT></TD></TR></TABLE>> tooltip="Express fractions as terminating or repeating decimals and terminating decimals as fractions."];
MATH_012 [id="MATH_012" color="#5579aa" fillcolor="#f0f5fd" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#5579aa">MATH_012</FONT></TD></TR><TR><TD><B>Signed numbers and order</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6</FONT></TD></TR></TABLE>> tooltip="Interpret positive and negative integers, opposites, zero, and order on a number line."];
MATH_013 [id="MATH_013" color="#5579aa" fillcolor="#f0f5fd" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#5579aa">MATH_013</FONT></TD></TR><TR><TD><B>Integer addition and<BR/>subtraction</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6–7</FONT></TD></TR></TABLE>> tooltip="Add and subtract integers using signed changes, opposites, and additive inverses."];
MATH_014 [id="MATH_014" color="#5579aa" fillcolor="#f0f5fd" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#5579aa">MATH_014</FONT></TD></TR><TR><TD><B>Integer multiplication and<BR/>division</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6–7</FONT></TD></TR></TABLE>> tooltip="Multiply and divide integers with consistent reasoning about signs."];
MATH_015 [id="MATH_015" color="#5579aa" fillcolor="#f0f5fd" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#5579aa">MATH_015</FONT></TD></TR><TR><TD><B>Signed rational-number<BR/>operations</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 7</FONT></TD></TR></TABLE>> tooltip="Compute with positive and negative fractions and decimals, including mixed representations."];
MATH_016 [id="MATH_016" color="#a27027" fillcolor="#fff7e6" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#a27027">MATH_016</FONT></TD></TR><TR><TD><B>Ratios</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6</FONT></TD></TR></TABLE>> tooltip="Interpret an ordered comparison of quantities in multiplicative terms."];
MATH_017 [id="MATH_017" color="#a27027" fillcolor="#fff7e6" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#a27027">MATH_017</FONT></TD></TR><TR><TD><B>Unit rates</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6–7</FONT></TD></TR></TABLE>> tooltip="Determine and interpret an amount per one unit, including rates involving fractions."];
MATH_018 [id="MATH_018" color="#a27027" fillcolor="#fff7e6" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#a27027">MATH_018</FONT></TD></TR><TR><TD><B>Proportional reasoning</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6–7</FONT></TD></TR></TABLE>> tooltip="Recognize equivalent ratios and determine missing quantities through consistent multiplicative scaling."];
MATH_019 [id="MATH_019" color="#a27027" fillcolor="#fff7e6" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#a27027">MATH_019</FONT></TD></TR><TR><TD><B>Percent representations</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6–7</FONT></TD></TR></TABLE>> tooltip="Interpret percent as a rate per hundred and express it using fractions and decimals."];
MATH_020 [id="MATH_020" color="#a27027" fillcolor="#fff7e6" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#a27027">MATH_020</FONT></TD></TR><TR><TD><B>Percent problem solving</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6–7</FONT></TD></TR></TABLE>> tooltip="Determine a part, whole, percentage, or percent change using proportional relationships."];
MATH_021 [id="MATH_021" color="#866753" fillcolor="#f8f1ec" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#866753">MATH_021</FONT></TD></TR><TR><TD><B>Whole-number exponents</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 5–6</FONT></TD></TR></TABLE>> tooltip="Interpret and evaluate powers with positive whole-number exponents as repeated multiplication."];
MATH_022 [id="MATH_022" color="#866753" fillcolor="#f8f1ec" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#866753">MATH_022</FONT></TD></TR><TR><TD><B>Integer exponent laws</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 8–9</FONT></TD></TR></TABLE>> tooltip="Apply product, quotient, and power laws, including zero and negative exponents with appropriate nonzero bases."];
MATH_023 [id="MATH_023" color="#866753" fillcolor="#f8f1ec" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#866753">MATH_023</FONT></TD></TR><TR><TD><B>Order of operations</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 5–6</FONT></TD></TR></TABLE>> tooltip="Evaluate numerical expressions using grouping, exponents, and conventional operation precedence."];
MATH_024 [id="MATH_024" color="#866753" fillcolor="#f8f1ec" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#866753">MATH_024</FONT></TD></TR><TR><TD><B>Commutative and associative<BR/>properties</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades ≤5–6</FONT></TD></TR></TABLE>> tooltip="Recognize when reordering or regrouping addition or multiplication preserves a value."];
MATH_025 [id="MATH_025" color="#866753" fillcolor="#f8f1ec" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#866753">MATH_025</FONT></TD></TR><TR><TD><B>Distributive property</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 5–7</FONT></TD></TR></TABLE>> tooltip="Understand why multiplying a sum or difference equals combining the corresponding products."];
MATH_026 [id="MATH_026" color="#43605b" fillcolor="#eff4f1" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#43605b">MATH_026</FONT></TD></TR><TR><TD><B>Meaning of equality</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades ≤5</FONT></TD></TR></TABLE>> tooltip="Interpret the equals sign as asserting that two quantities or expressions have the same value."];
MATH_027 [id="MATH_027" color="#7967a3" fillcolor="#f5f1fc" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#7967a3">MATH_027</FONT></TD></TR><TR><TD><B>Variables</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 5–6</FONT></TD></TR></TABLE>> tooltip="Interpret a symbol as an unknown, a varying quantity, or an arbitrary number."];
MATH_028 [id="MATH_028" color="#7967a3" fillcolor="#f5f1fc" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#7967a3">MATH_028</FONT></TD></TR><TR><TD><B>Algebraic expression<BR/>structure</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6–7</FONT></TD></TR></TABLE>> tooltip="Read and construct expressions, identifying terms, coefficients, factors, powers, and grouping."];
MATH_029 [id="MATH_029" color="#7967a3" fillcolor="#f5f1fc" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#7967a3">MATH_029</FONT></TD></TR><TR><TD><B>Substitution and expression<BR/>evaluation</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6–7</FONT></TD></TR></TABLE>> tooltip="Replace variables with specified rational values and compute the resulting expression."];
MATH_030 [id="MATH_030" color="#7967a3" fillcolor="#f5f1fc" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#7967a3">MATH_030</FONT></TD></TR><TR><TD><B>Equivalent linear<BR/>expressions</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6–8</FONT></TD></TR></TABLE>> tooltip="Rewrite linear expressions with rational coefficients through distribution, factoring, and combining like terms."];
MATH_031 [id="MATH_031" color="#7967a3" fillcolor="#f5f1fc" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#7967a3">MATH_031</FONT></TD></TR><TR><TD><B>Equations and their<BR/>solutions</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6–7</FONT></TD></TR></TABLE>> tooltip="Interpret an equation as a condition and a solution as a value that makes it true."];
MATH_032 [id="MATH_032" color="#7967a3" fillcolor="#f5f1fc" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#7967a3">MATH_032</FONT></TD></TR><TR><TD><B>Properties of equality</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6–7</FONT></TD></TR></TABLE>> tooltip="Preserve equality by applying the same valid operation to both sides, avoiding division by zero."];
MATH_033 [id="MATH_033" color="#866753" fillcolor="#f8f1ec" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#866753">MATH_033</FONT></TD></TR><TR><TD><B>Inverse operations</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 5–7</FONT></TD></TR></TABLE>> tooltip="Recognize how addition and subtraction, and multiplication and division, undo one another."];
MATH_034 [id="MATH_034" color="#7967a3" fillcolor="#f5f1fc" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#7967a3">MATH_034</FONT></TD></TR><TR><TD><B>Solving linear equations in<BR/>one variable</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 7–9</FONT></TD></TR></TABLE>> tooltip="Solve rational-coefficient linear equations, including variables on both sides and zero, one, or infinitely many solutions."];
MATH_035 [id="MATH_035" color="#7967a3" fillcolor="#f5f1fc" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#7967a3">MATH_035</FONT></TD></TR><TR><TD><B>Inequalities and their<BR/>solution sets</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6–7</FONT></TD></TR></TABLE>> tooltip="Interpret inequalities as ordered comparisons and describe satisfying values, including number-line representations."];
MATH_036 [id="MATH_036" color="#7967a3" fillcolor="#f5f1fc" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#7967a3">MATH_036</FONT></TD></TR><TR><TD><B>Solving linear inequalities<BR/>in one variable</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 7–9</FONT></TD></TR></TABLE>> tooltip="Isolate a variable while preserving the solution set, reversing order when multiplying or dividing by a negative."];
MATH_037 [id="MATH_037" color="#3a8470" fillcolor="#eef8f3" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#3a8470">MATH_037</FONT></TD></TR><TR><TD><B>Coordinate plane</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 5–6</FONT></TD></TR></TABLE>> tooltip="Locate and interpret ordered pairs on scaled perpendicular axes, including negative and fractional coordinates."];
MATH_038 [id="MATH_038" color="#3a8470" fillcolor="#eef8f3" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#3a8470">MATH_038</FONT></TD></TR><TR><TD><B>Covarying quantities</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 6–7</FONT></TD></TR></TABLE>> tooltip="Represent corresponding values of two varying quantities using ordered pairs and tables."];
MATH_039 [id="MATH_039" color="#a27027" fillcolor="#fff7e6" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#a27027">MATH_039</FONT></TD></TR><TR><TD><B>Representing proportional<BR/>relationships</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 7–8</FONT></TD></TR></TABLE>> tooltip="Connect equivalent-ratio tables, equations of the form y = kx, and straight-line graphs through the origin."];
MATH_040 [id="MATH_040" color="#3a8470" fillcolor="#eef8f3" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#3a8470">MATH_040</FONT></TD></TR><TR><TD><B>Linear relationships</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 7–8</FONT></TD></TR></TABLE>> tooltip="Recognize a constant rate of change between quantities, allowing a nonzero initial value."];
MATH_041 [id="MATH_041" color="#3a8470" fillcolor="#eef8f3" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#3a8470">MATH_041</FONT></TD></TR><TR><TD><B>Slope</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 8–9</FONT></TD></TR></TABLE>> tooltip="Interpret and calculate Δy/Δx as a line’s rate of change; recognize undefined slope for vertical lines."];
MATH_042 [id="MATH_042" color="#3a8470" fillcolor="#eef8f3" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#3a8470">MATH_042</FONT></TD></TR><TR><TD><B>Graphing linear equations</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 8–9</FONT></TD></TR></TABLE>> tooltip="Graph two-variable linear equations using slope, intercepts, or equivalent forms, including horizontal and vertical lines."];
MATH_043 [id="MATH_043" color="#3a8470" fillcolor="#eef8f3" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#3a8470">MATH_043</FONT></TD></TR><TR><TD><B>Functions</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 8–9</FONT></TD></TR></TABLE>> tooltip="Recognize a correspondence that assigns exactly one output to each allowed input."];
MATH_044 [id="MATH_044" color="#3a8470" fillcolor="#eef8f3" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#3a8470">MATH_044</FONT></TD></TR><TR><TD><B>Function notation and<BR/>evaluation</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 8–9</FONT></TD></TR></TABLE>> tooltip="Interpret f(x) as an output and evaluate a function rule at specified inputs."];
MATH_045 [id="MATH_045" color="#3a8470" fillcolor="#eef8f3" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#3a8470">MATH_045</FONT></TD></TR><TR><TD><B>Constructing linear models</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 8–9</FONT></TD></TR></TABLE>> tooltip="Construct a linear function from a table, graph, two points, or contextual rate and initial value."];
MATH_046 [id="MATH_046" color="#b05e62" fillcolor="#fff1f1" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#b05e62">MATH_046</FONT></TD></TR><TR><TD><B>Systems and simultaneous<BR/>solutions</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 8–9</FONT></TD></TR></TABLE>> tooltip="Interpret a linear system’s solution as an ordered pair satisfying every equation simultaneously."];
MATH_047 [id="MATH_047" color="#b05e62" fillcolor="#fff1f1" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#b05e62">MATH_047</FONT></TD></TR><TR><TD><B>Solving linear systems<BR/>algebraically</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 8–9</FONT></TD></TR></TABLE>> tooltip="Solve two-variable linear systems through substitution or elimination and identify the number of solutions."];
MATH_048 [id="MATH_048" color="#b05e62" fillcolor="#fff1f1" label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="9" COLOR="#b05e62">MATH_048</FONT></TD></TR><TR><TD><B>Solving linear systems<BR/>graphically</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#64736e">Grades 8–9</FONT></TD></TR></TABLE>> tooltip="Determine or estimate shared solutions from intersecting, parallel, or coincident lines."];
  MATH_001 -> MATH_002 [id="edge_MATH_001_MATH_002" tooltip="Place-value units explain regrouping in addition and subtraction."];
MATH_002 -> MATH_003 [id="edge_MATH_002_MATH_003" tooltip="Combining equal groups and repeated subtraction ground multiplication and division."];
